# Django
DJANGO_SECRET_KEY=replace-with-a-real-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_LOG_LEVEL=INFO
# DB_ENGINE=postgres
# Database engine: sqlite for local development, postgres for docker-compose
DB_ENGINE=sqlite

# Postgres
POSTGRES_DB=dissertacia
POSTGRES_USER=dissertacia
POSTGRES_PASSWORD=dissertacia
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Qdrant (optional search profile)
QDRANT_ENABLED=0
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_TIMEOUT_SECONDS=3

# Backend startup
STARTUP_WAIT_TIMEOUT_SECONDS=60


ENTITY_LLM_API_URL=http://host.docker.internal:11434/v1/chat/completions
ENTITY_LLM_API_KEY=change-me
ENTITY_LLM_MODEL=qwen2.5:3b-instruct
ENTITY_LLM_TIMEOUT_SECONDS=120
# Result explanation LLM (optional; disabled for local MVP by default)
RESULT_LLM_ENABLED=False
RESULT_LLM_API_URL=http://127.0.0.1:11434/api/generate
RESULT_LLM_MODEL=llama3.1:8b
RESULT_LLM_TIMEOUT_SECONDS=60
RESULT_LLM_TEMPERATURE=0
RESULT_LLM_SEED=42
RESULT_PASS_THRESHOLD_PERCENT=70
